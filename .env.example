VITE_API_URL=

# Optional. Origin that short links point at, without a trailing slash.
# Defaults to $VITE_API_URL/links, because the backend serves the redirect at
# GET /links/:shortCode. Set this only once a bare GET /:shortCode works
# (or you have a short domain), e.g. VITE_SHORT_LINK_ORIGIN=https://squish.li
VITE_SHORT_LINK_ORIGIN=
